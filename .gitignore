# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit .env.example instead
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
*.log
dev.log
dev.out.log
test
prompt
server.log
worklog.md

# Skills directory (sandbox tooling)
/skills/

# SQLite database — schema is in prisma/schema.prisma; the db is created by `prisma db push`
/db/*.db
/db/*.db-journal

# Sandbox/QA artifacts (not part of the product)
/tests
/tool-results
/download
/examples
/worklog.md
/qa-*.png
/verify-*.png
